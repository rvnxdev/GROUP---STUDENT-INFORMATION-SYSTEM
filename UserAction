        // ==========================================
        // PART 5 - ADD STUDENT
        // ==========================================

        private void addStudent() {

            JTextField id = new JTextField();
            JTextField name = new JTextField();
            JTextField age = new JTextField();
            JTextField course = new JTextField();
            JTextField year = new JTextField();
            JTextField gpa = new JTextField();

            Object[] fields = {
                "Student ID:", id,
                "Full Name:", name,
                "Age:", age,
                "Course:", course,
                "Year Level:", year,
                "GPA:", gpa
            };

            int result = JOptionPane.showConfirmDialog(
                this,
                fields,
                "Register Student",
                JOptionPane.OK_CANCEL_OPTION
            );

            if (result != JOptionPane.OK_OPTION) {
                return;
            }

            try {

                int studentID = Integer.parseInt(
                    id.getText().trim()
                );

                int studentAge = Integer.parseInt(
                    age.getText().trim()
                );

                double studentGPA = Double.parseDouble(
                    gpa.getText().trim()
                );

                validate(
                    name.getText(),
                    studentAge,
                    course.getText(),
                    year.getText(),
                    studentGPA
                );

                if (findStudent(studentID) != -1) {

                    throw new IllegalArgumentException(
                        "Student ID already exists."
                    );
                }

                students.add(new StudentRecord(
                    studentID,
                    name.getText().trim(),
                    studentAge,
                    course.getText().trim(),
                    year.getText().trim(),
                    studentGPA
                ));

                refreshTable();
                onChange.run();

                JOptionPane.showMessageDialog(
                    this,
                    "Student successfully added!"
                );

            } catch (NumberFormatException ex) {

                showError(
                    "Please enter valid numeric values."
                );

            } catch (IllegalArgumentException ex) {

                showError(ex.getMessage());
            }
        }

        // ==========================================
        // UPDATE STUDENT
        // ==========================================

        private void updateStudent() {

            int row = table.getSelectedRow();

            if (row == -1) {

                showError(
                    "Please select a student first."
                );

                return;
            }

            int id = (int) model.getValueAt(row, 0);

            int index = findStudent(id);

            if (index == -1) return;

            StudentRecord old = students.get(index);

            JTextField name = new JTextField(old.name);

            JTextField age = new JTextField(
                String.valueOf(old.age)
            );

            JTextField course = new JTextField(old.course);

            JTextField year = new JTextField(old.year);

            JTextField gpa = new JTextField(
                String.valueOf(old.gpa)
            );

            Object[] fields = {
                "Full Name:", name,
                "Age:", age,
                "Course:", course,
                "Year Level:", year,
                "GPA:", gpa
            };

            int result = JOptionPane.showConfirmDialog(
                this,
                fields,
                "Update Student",
                JOptionPane.OK_CANCEL_OPTION
            );

            if (result != JOptionPane.OK_OPTION) {
                return;
            }

            try {

                int studentAge = Integer.parseInt(
                    age.getText().trim()
                );

                double studentGPA = Double.parseDouble(
                    gpa.getText().trim()
                );

                validate(
                    name.getText(),
                    studentAge,
                    course.getText(),
                    year.getText(),
                    studentGPA
                );

                students.set(index, new StudentRecord(
                    id,
                    name.getText().trim(),
                    studentAge,
                    course.getText().trim(),
                    year.getText().trim(),
                    studentGPA
                ));

                refreshTable();
                onChange.run();

                JOptionPane.showMessageDialog(
                    this,
                    "Student record updated!"
                );

            } catch (NumberFormatException ex) {

                showError(
                    "Please enter valid numeric values."
                );

            } catch (IllegalArgumentException ex) {

                showError(ex.getMessage());
            }
        }

        // ==========================================
        // DELETE STUDENT
        // ==========================================

        private void deleteStudent() {

            int row = table.getSelectedRow();

            if (row == -1) {

                showError(
                    "Please select a student first."
                );

                return;
            }

            int id = (int) model.getValueAt(row, 0);

            int confirm = JOptionPane.showConfirmDialog(
                this,
                "Are you sure you want to delete this student?",
                "Confirm Deletion",
                JOptionPane.YES_NO_OPTION
            );

            if (confirm == JOptionPane.YES_OPTION) {

                int index = findStudent(id);

                if (index != -1) {
                    students.remove(index);
                }

                refreshTable();
                onChange.run();

                JOptionPane.showMessageDialog(
                    this,
                    "Student successfully deleted!"
                );
            }
        }

        // ==========================================
        // PART 6 - SEARCH STUDENT
        // ==========================================

        private void searchStudents() {

            String keyword = searchField.getText()
                .trim().toLowerCase();

            model.setRowCount(0);

            for (StudentRecord student : students) {

                String id = String.valueOf(student.id);

                String name = student.name.toLowerCase();

                if (id.contains(keyword)
                    || name.contains(keyword)) {

                    addRow(student);
                }
            }
        }

        // ==========================================
        // REFRESH STUDENT TABLE
        // ==========================================

        void refreshTable() {

            model.setRowCount(0);

            for (StudentRecord student : students) {

                addRow(student);
            }
        }

        // ==========================================
        // ADD STUDENT TO TABLE
        // ==========================================

        private void addRow(StudentRecord student) {

            model.addRow(new Object[]{

                student.id,
                student.name,
                student.age,
                student.course,
                student.year,
                student.gpa

            });
        }

        // ==========================================
        // FIND STUDENT BY ID
        // ==========================================

        private int findStudent(int id) {

            for (int i = 0; i < students.size(); i++) {

                if (students.get(i).id == id) {

                    return i;
                }
            }

            return -1;
        }

        // ==========================================
        // INPUT VALIDATION
        // ==========================================

        private void validate(
            String name,
            int age,
            String course,
            String year,
            double gpa
        ) {

            if (name.trim().isEmpty()
                || course.trim().isEmpty()
                || year.trim().isEmpty()) {

                throw new IllegalArgumentException(
                    "Please complete all required fields."
                );
            }

            if (age < 1 || age > 120) {

                throw new IllegalArgumentException(
                    "Please enter a valid age."
                );
            }

            if (gpa < 0 || gpa > 5) {

                throw new IllegalArgumentException(
                    "GPA must be between 0 and 5."
                );
            }
        }

        // ==========================================
        // ERROR MESSAGE
        // ==========================================

        private void showError(String message) {

            JOptionPane.showMessageDialog(
                this,
                message,
                "Input Error",
                JOptionPane.WARNING_MESSAGE
            );
        }

        // ==========================================
        // GET STUDENT RECORDS
        // ==========================================

        ArrayList<StudentRecord> getStudents() {

            return students;
        }

    }

