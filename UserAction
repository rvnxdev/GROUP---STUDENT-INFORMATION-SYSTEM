            }

            // CREATE TABLE

            JTable table = new JTable(model);

            table.setRowHeight(35);

            table.setFont(
                new Font("Arial", Font.PLAIN, 13)
            );

            table.getTableHeader().setFont(
                new Font("Arial", Font.BOLD, 12)
