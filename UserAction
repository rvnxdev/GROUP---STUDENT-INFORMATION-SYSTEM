        // UPDATE DASHBOARD STATISTICS

        void updateStatistics(
            ArrayList<StudentRecord> students
        ) {

            totalStudents.setText(
                String.valueOf(students.size())
            );

            double total = 0;

            int risk = 0;

            for (StudentRecord student : students) {

                total += student.gpa;

                if (student.gpa < 3.00) {
                    risk++;
                }
            }

            double average = students.isEmpty()
                ? 0
                : total / students.size();

            averageGPA.setText(
                String.format("%.2f", average)
            );

            atRisk.setText(
                String.valueOf(risk)
            );
        }
    }
    
